[Unit]
Description=Skudo API (FastAPI + panel web)
After=network.target network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ingmar
WorkingDirectory=/opt/skudo
EnvironmentFile=/etc/skudo/skudo.env
EnvironmentFile=/opt/skudo/deploy/jwt-secret.env
ExecStart=/opt/skudo/.venv/bin/skudo serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
